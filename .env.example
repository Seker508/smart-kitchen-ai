# --- Veritabanı (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartkitchen?schema=public"

# --- Oturum ---
# En az 32 karakterlik rastgele bir değer. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="degistir-beni-en-az-32-karakter-uzunlugunda-gizli-anahtar"

# Uygulamanın dış adresi (şifre sıfırlama bağlantıları için)
APP_URL="http://localhost:3000"

# --- Yapay zekâ ---
# Sağlayıcı: openai | gemini | anthropic  (boş bırakılırsa anahtarı tanımlı olan ilk sağlayıcı kullanılır)
AI_PROVIDER=""

OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_CHAT_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# --- Dosya yükleme ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="8"

# Geliştirme ortamında e-posta sunucusu yoksa şifre sıfırlama bağlantısını ekranda göster (production'da her zaman kapalıdır)
SHOW_RESET_LINK_IN_DEV="true"
